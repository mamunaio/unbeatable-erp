generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STOCK_KEEPER
  ACCOUNTANT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  WASTAGE
  CORRECTION
}

enum SaleStatus {
  DRAFT
  COMPLETED
  HELD
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK
  BKASH
  NAGAD
  ROCKET
  CREDIT
  OTHER
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum CustomerType {
  WALK_IN
  RETAIL
  WHOLESALE
  REGULAR
}

model Tenant {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  status          TenantStatus    @default(TRIAL)
  phone           String?
  email           String?
  address         String?         @db.Text
  currency        String          @default("BDT")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  users           User[]
  branches        Branch[]
  warehouses      Warehouse[]
  categories      Category[]
  brands          Brand[]
  units           Unit[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  purchases       Purchase[]
  sales           Sale[]
  shifts          Shift[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
}

model Branch {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  code        String
  phone       String?
  address     String?      @db.Text
  isMain      Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  counters    Counter[]
  shifts      Shift[]
  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]
  users       User[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Counter {
  id          String       @id @default(cuid())
  tenantId    String
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name        String
  code        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shifts      Shift[]
  sales       Sale[]

  @@unique([branchId, code])
  @@index([tenantId, isActive])
}

model Shift {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  counterId      String
  counter        Counter      @relation(fields: [counterId], references: [id], onDelete: Restrict)
  cashierId      String
  cashier        User         @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  status         ShiftStatus  @default(OPEN)
  
  openingCash    Decimal      @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?     @db.Decimal(12, 2)
  expectedCash   Decimal?     @db.Decimal(12, 2)
  cashVariance   Decimal?     @db.Decimal(12, 2)
  notes          String?      @db.Text

  sales          Sale[]
  payments       Payment[]

  @@index([tenantId, status])
  @@index([branchId, openedAt])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole   @default(CASHIER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shifts       Shift[]
  sales        Sale[]
  purchases    Purchase[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, role])
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Brand {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, slug])
}

model Unit {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  symbol    String
  products  Product[]
  createdAt DateTime   @default(now())

  @@unique([tenantId, symbol])
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitId         String?
  unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  
  name           String
  slug           String
  sku            String
  barcode        String?
  description    String?         @db.Text
  image          String?
  
  purchasePrice  Decimal         @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal         @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal?        @db.Decimal(12, 2)
  mrp            Decimal?        @db.Decimal(12, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  
  stock          Decimal         @default(0) @db.Decimal(12, 3)
  reorderPoint   Decimal         @default(0) @db.Decimal(12, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
}

model Warehouse {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  address   String?         @db.Text
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String?
  warehouse   Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 2)
  reference   String?
  reason      String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type, createdAt])
}

model Customer {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  phone       String?
  email       String?
  address     String?      @db.Text
  type        CustomerType @default(WALK_IN)
  creditLimit Decimal      @default(0) @db.Decimal(12, 2)
  dueBalance  Decimal      @default(0) @db.Decimal(12, 2)
  points      Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sales       Sale[]
  payments    Payment[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@index([tenantId, dueBalance])
}

model Supplier {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?      @db.Text
  dueBalance  Decimal      @default(0) @db.Decimal(12, 2)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  purchases   Purchase[]

  @@index([tenantId, name])
}

model Purchase {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  invoiceNo   String
  status      PurchaseStatus @default(RECEIVED)
  
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  discount    Decimal        @default(0) @db.Decimal(12, 2)
  tax         Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal        @default(0) @db.Decimal(12, 2)
  dueAmount   Decimal        @default(0) @db.Decimal(12, 2)
  
  notes       String?        @db.Text
  purchaseDate DateTime      @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       PurchaseItem[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, supplierId, purchaseDate])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  counterId    String?
  counter      Counter?      @relation(fields: [counterId], references: [id], onDelete: SetNull)
  shiftId      String?
  shift        Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashierId    String
  cashier      User          @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  
  invoiceNo    String
  status       SaleStatus    @default(COMPLETED)
  
  subtotal     Decimal       @default(0) @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount    Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount Decimal       @default(0) @db.Decimal(12, 2)
  
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        SaleItem[]
  payments     Payment[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  productName String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  saleId        String?
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId       String?
  shift         Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  method        PaymentMethod @default(CASH)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PAID)
  referenceNo   String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@index([shiftId])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@unique([tenantId, name])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  paidThrough String?
  reference   String?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, branchId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entity, createdAt])
  @@index([tenantId, userId, createdAt])
}
